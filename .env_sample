# ENV Settings

APP_MODE=local                  # local | production
WEB_URL=http://localhost:3000
API_PORT=
COOKIE_SECURE=true

# AWS: the local profile (~/.aws/credentials). No access keys in this file.
AWS_PROFILE=some_aws_profile_name
AWS_REGION=us-east-2
AWS_SES_REGION=us-east-2

# MongoDB Atlas (or a local replica set: mongodb://127.0.0.1:27017/?replicaSet=rs0)
MONGODB_URL='mongodb+srv://some_username:some_password@some-cluster-name.nnvwvhe.mongodb.net/some_name_here?retryWrites=true&w=majority'
MONGODB_DB=some_name_here

# Emails
MAIL_FROM="GreenLove Farms LLC <mail@oarsland.com>"
EMAIL_ALLOWLIST=mail@oarsland.com
ADMIN_ALERT_EMAILS=mail@oarsland.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ENVIRONMENT=dev

# Upload Configuration
CLOUDINARY_TIMEOUT_MS=600000
UPLOAD_TIMEOUT_MS=600000

POSTMAN_API_KEY=PMAK-
POSTMAN_TEST_EMAIL=
POSTMAN_TEST_PASSWORD=
POSTMAN_ADMIN_EMAIL=
POSTMAN_ADMIN_PASSWORD=
